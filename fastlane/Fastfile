default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Headless signing: automatic signing asks Apple for a *development*
    # profile, which needs a registered device. Instead, create the
    # distribution certificate + App Store profile directly and sign
    # manually — no device involved.
    keychain_name = "build.keychain"
    keychain_password = "ci-build-password"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    get_certificates(
      api_key: api_key,
      team_id: "NX47Z37H39",
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password
    )

    profile_name = "Mehr Iran Dokht App Store"
    profile_path = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "ca.elnazmoghadam.mehrirandokht",
      provisioning_name: profile_name,
      team_id: "NX47Z37H39",
      force: true
    )
    # Use the name sigh actually created (it may differ), and make sure the
    # profile file sits in both places Xcode versions look for it.
    actual_profile_name = lane_context[SharedValues::SIGH_NAME] || profile_name
    if profile_path && File.exist?(profile_path)
      require "fileutils"
      ["~/Library/MobileDevice/Provisioning Profiles",
       "~/Library/Developer/Xcode/UserData/Provisioning Profiles"].each do |dir|
        dir = File.expand_path(dir)
        FileUtils.mkdir_p(dir)
        FileUtils.cp(profile_path, dir)
      end
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "NX47Z37H39",
      bundle_identifier: "ca.elnazmoghadam.mehrirandokht",
      code_sign_identity: "Apple Distribution",
      profile_name: actual_profile_name
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "ca.elnazmoghadam.mehrirandokht" => actual_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
